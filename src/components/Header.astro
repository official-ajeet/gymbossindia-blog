---
// Trimmed blog-specific header — deliberately NOT a full port of
// SiteNav.jsx. A reader landing on a post from search wants to read,
// not choose between 7 product nav links. Full product navigation still
// lives in Footer.astro (the SEO-relevant internal links are all there);
// this header keeps exactly one job: brand identity + one conversion path.
// Scroll-triggered background is kept from SiteNav.jsx since it's a nice
// touch and costs nothing. No hamburger/drawer — two buttons fit at every
// breakpoint, so there's nothing left to collapse.
---

<nav id="site-nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between">
    <a href="https://gymboss.in/" class="flex items-center shrink-0">
      <img
        src="https://gymboss.in/GymBoss%20India%20Logo-h.png"
        alt="GymBoss India"
        class="h-8 sm:h-10 w-auto object-contain shrink-0"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="https://gymboss.in/login" class="text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 px-2 sm:px-4 py-2 transition">
        Sign In
      </a>
      <a href="https://gymboss.in/signup" class="text-xs sm:text-sm font-bold bg-slate-900 text-white px-4 sm:px-5 py-2 sm:py-2.5 rounded-lg sm:rounded-xl hover:bg-slate-700 transition whitespace-nowrap">
        Start Free Trial
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const scrolledClasses = ['bg-white/95', 'backdrop-blur', 'shadow-sm', 'border-b', 'border-slate-100'];
  const onScroll = () => {
    const isScrolled = window.scrollY > 20;
    nav?.classList.toggle('bg-transparent', !isScrolled);
    scrolledClasses.forEach((c) => nav?.classList.toggle(c, isScrolled));
  };
  window.addEventListener('scroll', onScroll);
  onScroll();
</script>