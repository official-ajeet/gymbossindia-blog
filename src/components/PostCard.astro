---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = `${import.meta.env.BASE_URL}/${post.id}`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={href}
  class="group block rounded-2xl border border-slate-100 bg-white overflow-hidden hover:border-slate-200 hover:shadow-lg transition-all duration-300"
>
  {post.data.heroImage && (
    <div class="aspect-video overflow-hidden bg-slate-100">
      <img
        src={post.data.heroImage}
        alt={post.data.heroImageAlt ?? ''}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
      />
    </div>
  )}
  <div class="p-5">
    <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-400">
      {formattedDate}
    </time>
    <h2 class="font-serif text-lg text-slate-900 mt-1 mb-1.5 leading-snug">
      {post.data.title}
    </h2>
    <p class="text-sm text-slate-500 leading-relaxed">{post.data.description}</p>
  </div>
</a>
