---
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  otherPosts?: CollectionEntry<'blog'>[];
}

const { post, otherPosts = [] } = Astro.props;
const { title, description, heroImage, heroImageAlt, pubDate, updatedDate, author, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// post.body is the raw Markdown/MDX source — good enough for a rough estimate.
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
>
  <article class="max-w-2xl mx-auto py-8 md:py-12 px-5">
    
    <a
      href={`${import.meta.env.BASE_URL}`}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-blue-600 transition mb-6"
    >
      ← Back to all posts
    </a>

    <header class="mb-6">
      <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-3">GymBoss India Blog</p>
      <h1 class="font-serif text-3xl md:text-5xl text-slate-900 leading-tight mb-4">{title}</h1>
      <p class="text-sm text-slate-400">
        By {author} · <time datetime={pubDate.toISOString()}>{formattedDate}</time> · {readingMinutes} min read
      </p>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="text-xs font-semibold text-blue-700 bg-blue-50 rounded-full px-3 py-1">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {heroImage && (
      <img src={heroImage} alt={heroImageAlt ?? ''} class="w-full rounded-2xl mb-8 shadow-sm" />
    )}

    <div class="prose prose-slate prose-lg max-w-none prose-headings:font-serif prose-a:text-blue-600 prose-img:rounded-2xl">
      <slot />
    </div>
  </article>

  {otherPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-5 md:px-6 py-14 md:py-20 border-t border-slate-100 mt-8">
      <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-3">Keep reading</p>
      <h2 class="font-serif text-2xl md:text-3xl text-slate-900 mb-8">More from the blog</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {otherPosts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>